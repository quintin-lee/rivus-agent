# Rivus Agent 环境变量示例
# 复制为 .env 并填入实际值：cp .env.example .env

# ---- 模型服务（OpenAI 兼容网关）----
# 必填
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
# 可选：模型提供方标识（环境变量 MODEL_PROVIDER，缺省走 OpenAI 兼容协议）
MODEL_PROVIDER=

# ---- 后端服务 ----
# API 鉴权 Token；为空则不鉴权（仅限本地开发）
AGENT_AUTH_TOKEN=
# 并发 Worker 数
WORKER_CONCURRENCY=1
# 日志级别：debug / info / warn / error
LOG_LEVEL=info
# 工具工作区根目录（file_* 工具的读写范围，禁路径穿越）
AGENT_WORKSPACE_DIR=./workspace
# 知识库目录（knowledge_search 检索范围，与工作区分离）
AGENT_KNOWLEDGE_DIR=./knowledge
# http_fetch 域名白名单（逗号分隔，精确匹配 host；为空 = http_fetch 完全禁用）
AGENT_HTTP_FETCH_ALLOWLIST=
# API 速率限制（每分钟每客户端请求数，按 X-Owner-ID 或来源 IP 分桶；0 = 关闭）
AGENT_RATE_LIMIT_RPM=0

# ---- S3 对象存储（可选）----
# 端点非空即接线 S3 工具（s3_read / s3_write / s3_list）；为空则完全禁用
AGENT_S3_ENDPOINT=
AGENT_S3_REGION=
AGENT_S3_BUCKET=
AGENT_S3_ACCESS_KEY_ID=
# 仅经环境变量注入，永不写入 yaml / 序列化输出
AGENT_S3_SECRET_ACCESS_KEY=
# 是否走 HTTPS（true / false）
AGENT_S3_USE_SSL=false
# 强制 path-style URL（MinIO / Ceph 需要 true；兼容 AWS 域名时保持默认 true 即可）
AGENT_S3_FORCE_PATH_STYLE=true
# s3_read / s3_write 的 key 前缀（工作区隔离）
AGENT_S3_WORKSPACE_PREFIX=
# s3_list 的 key 前缀（知识库隔离）
AGENT_S3_KNOWLEDGE_PREFIX=

# pprof 调试端点（/debug/pprof/*）；不设则跟随认证开关（配置了 AGENT_AUTH_TOKEN 才开启）
#AGENT_PPROF=false

# ---- Docker 构建 ----
# 国内镜像源前缀（含尾部斜杠）；如使用 registry.1ms.run 加速拉取
DOCKER_REGISTRY=
