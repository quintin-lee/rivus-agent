# Rivus Agent 环境变量示例
# 复制为 .env 并填入实际值：cp .env.example .env

# ---- 模型服务（OpenAI 兼容网关）----
# 必填
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini

# ---- 后端服务 ----
# API 鉴权 Token；为空则不鉴权（仅限本地开发）
AGENT_AUTH_TOKEN=
# 并发 Worker 数
WORKER_CONCURRENCY=1
# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# ---- Docker 构建 ----
# 国内镜像源前缀（含尾部斜杠）；如使用 registry.1ms.run 加速拉取
DOCKER_REGISTRY=
